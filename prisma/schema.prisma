// Modelo de datos — Fase 2.
// Convención: modelos en PascalCase, tablas mapeadas a snake_case plural
// con @@map; columnas con los nombres por defecto de Prisma.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EventType {
  SUGGESTIONS
  VOTING
  RAFFLE
}

enum OptionSource {
  MANUAL
  FROM_SUGGESTIONS
}

enum EventStatus {
  DRAFT
  SUGGESTIONS_ACTIVE
  SUGGESTIONS_FINISHED
  VOTING_ACTIVE
  VOTING_FINISHED
  TIE
  COMPLETED
  CANCELLED
  // Estados del sorteo (type = RAFFLE)
  REGISTRATION_OPEN
  REGISTRATION_CLOSED
  DRAWING
}

enum RoundPhase {
  SUGGESTIONS
  VOTING
  FINISHED
  REGISTRATION
}

model User {
  id             String    @id @default(cuid())
  twitchId       String    @unique
  login          String
  displayName    String
  accessToken    String
  refreshToken   String
  tokenExpiresAt DateTime
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  channel        Channel?

  @@map("users")
}

model Channel {
  id        String   @id @default(cuid())
  twitchId  String   @unique
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  events    Event[]

  @@map("channels")
}

model Event {
  id                    String       @id @default(cuid())
  channelId             String
  channel               Channel      @relation(fields: [channelId], references: [id], onDelete: Cascade)
  type                  EventType
  status                EventStatus  @default(DRAFT)
  suggestionDurationSec Int          @default(60)
  votingDurationSec     Int          @default(60)
  // Tope de opciones importadas en VOTING con origen FROM_SUGGESTIONS.
  maxOptions            Int          @default(10)
  // Origen de las opciones de votación (type = VOTING).
  optionSource          OptionSource @default(MANUAL)
  // Configuración del sorteo (type = RAFFLE). maxParticipants null = sin límite.
  registrationDurationSec Int         @default(300)
  maxParticipants         Int?
  createdAt             DateTime    @default(now())
  startedAt             DateTime?
  endedAt               DateTime?
  rounds                Round[]
  eventOptions          EventOption[]
  raffleParticipants    RaffleParticipant[]

  @@index([channelId, status])
  @@map("events")
}

model Round {
  id             String          @id @default(cuid())
  eventId        String
  event          Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  number         Int
  phase          RoundPhase
  phaseStartedAt DateTime?
  phaseEndsAt    DateTime?
  createdAt      DateTime        @default(now())
  suggestions    Suggestion[]
  suggestionBans SuggestionBan[]
  votingOptions  VotingOption[]
  votes          Vote[]

  @@unique([eventId, number])
  @@map("rounds")
}

model Suggestion {
  id             String         @id @default(cuid())
  roundId        String
  round          Round          @relation(fields: [roundId], references: [id], onDelete: Cascade)
  twitchUserId   String
  twitchLogin    String
  // Título oficial de IGDB cuando hubo match; si no, el texto del usuario.
  gameName       String
  normalizedName String
  // Id del juego en IGDB (null si IGDB falló y se aceptó en fail-open).
  igdbGameId     Int?
  createdAt      DateTime       @default(now())

  @@unique([roundId, twitchUserId])
  @@unique([roundId, normalizedName])
  @@map("suggestions")
}

model SuggestionBan {
  id             String   @id @default(cuid())
  roundId        String
  round          Round    @relation(fields: [roundId], references: [id], onDelete: Cascade)
  normalizedName String
  createdAt      DateTime @default(now())

  @@unique([roundId, normalizedName])
  @@map("suggestion_bans")
}

model VotingOption {
  id           String     @id @default(cuid())
  roundId      String
  round        Round      @relation(fields: [roundId], references: [id], onDelete: Cascade)
  position     Int
  gameName     String
  createdAt    DateTime   @default(now())
  votes        Vote[]

  @@unique([roundId, position])
  @@map("voting_options")
}

// Opciones manuales de un evento de votación (Event.type = VOTING con
// optionSource = MANUAL). Editables mientras el evento está en DRAFT; al
// iniciar la votación se copian a VotingOption.
model EventOption {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  position  Int
  label     String
  createdAt DateTime @default(now())

  @@unique([eventId, position])
  @@map("event_options")
}

model Vote {
  id             String       @id @default(cuid())
  roundId        String
  round          Round        @relation(fields: [roundId], references: [id], onDelete: Cascade)
  votingOptionId String
  votingOption   VotingOption @relation(fields: [votingOptionId], references: [id], onDelete: Cascade)
  twitchUserId   String
  createdAt      DateTime     @default(now())

  @@unique([roundId, twitchUserId])
  @@map("votes")
}

// Participantes de un sorteo (Event.type = RAFFLE). La identidad real es
// twitchUserId (el login puede cambiar); la unicidad por (eventId,
// twitchUserId) garantiza que !participo repetido no duplica.
// excludedFromRedraw: ganadores anteriores que no pueden volver a ganar.
model RaffleParticipant {
  id                 String   @id @default(cuid())
  eventId            String
  event              Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  twitchUserId       String
  twitchLogin        String
  isWinner           Boolean  @default(false)
  excludedFromRedraw Boolean  @default(false)
  createdAt          DateTime @default(now())

  @@unique([eventId, twitchUserId])
  @@map("raffle_participants")
}
