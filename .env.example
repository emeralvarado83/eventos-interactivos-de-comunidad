# Base de datos PostgreSQL (ver docker-compose.yml)
DATABASE_URL="postgresql://twitch_events:twitch_events@localhost:5432/twitch_events"

# Credenciales de la aplicación registrada en https://dev.twitch.tv/console
TWITCH_CLIENT_ID=""
TWITCH_CLIENT_SECRET=""
TWITCH_REDIRECT_URI="http://localhost:3000/api/auth/twitch/callback"

# Secreto para firmar sesiones. Generar con: openssl rand -base64 32
SESSION_SECRET=""

# Validación de sugerencias contra el catálogo IGDB ("on" por defecto; usa las
# mismas credenciales TWITCH_CLIENT_ID/SECRET). Poner "off" si el canal sugiere
# juegos que no están en IGDB (itch.io, mods, fangames).
IGDB_VALIDATION="on"

# Puerto del servidor (server.ts)
PORT=3000
